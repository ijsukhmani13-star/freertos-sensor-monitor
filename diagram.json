    { "type": "wokwi-dht22", "id": "dht1", "top": -95, "left": 180, "attrs": { "temperature": "24", "humidity": "45" } },
    { "type": "wokwi-potentiometer", "id": "pot1", "top": 60, "left": -170, "attrs": {} },
    { "type": "board-ssd1306", "id": "oled1", "top": 160, "left": 200, "attrs": { "i2cAddress": "0x3c" } },
    { "type": "wokwi-led", "id": "led1", "top": 40, "left": 290, "attrs": { "color": "red" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 110, "left": 270, "rotate": 90, "attrs": { "value": "220" } },
